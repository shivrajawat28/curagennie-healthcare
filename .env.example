# CuraGennie Environment Configuration
# All features work out of the box with zero external API keys!

# Environment mode
APP_ENV=development
DEBUG=True

# Backend Server Configuration
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration
DATABASE_URL=sqlite:///./curagennie.db

